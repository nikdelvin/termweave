{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Termweave SDK Runtime",
  "version": "2.0.0",
  "identifier": "dev.termweave.sdk",
  "build": {
    "beforeDevCommand": "bun run frontend:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run frontend:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Termweave SDK Runtime",
        "width": 1536,
        "height": 864,
        "closable": true,
        "minimizable": true,
        "resizable": true,
        "maximizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["../termweave/host/crt-effects/assets/crt-noise.png"],
    "externalBin": ["binaries/opentui-sidecar"]
  }
}
