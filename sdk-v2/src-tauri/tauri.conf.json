{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Termweave App",
  "version": "0.1.0",
  "identifier": "com.example.termweave-app",
  "build": {
    "beforeDevCommand": "bun run frontend:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run frontend:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Termweave App",
        "width": 1536,
        "height": 864,
        "closable": true,
        "minimizable": true,
        "resizable": true,
        "maximizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "visible": false,
        "backgroundColor": "#010416"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["../app.icon.png"]
  }
}
