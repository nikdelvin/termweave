{
  "name": "termweave",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "imports": {
    "#termweave": "./termweave/index.ts"
  },
  "scripts": {
    "dev": "bun run prepare && bun scripts/build-sidecar.ts development && tauri dev --config src-tauri/.generated/override.json",
    "build": "bun run prepare && bun scripts/build-sidecar.ts && tauri build --config src-tauri/.generated/override.json",
    "prepare": "bun scripts/prepare.ts",
    "sidecar:build": "bun scripts/build-sidecar.ts",
    "frontend:dev": "vite",
    "frontend:build": "tsc --noEmit && vite build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "@opentui/core": "^0.5.17",
    "@opentui/react": "^0.5.17",
    "@opentui/three": "^0.5.17",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "react": "^19.1.0",
    "three": "0.177.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.8",
    "@types/three": "0.177.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
