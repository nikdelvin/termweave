{
  "schemaVersion": 1,
  "ffmpegVersion": "8.1.2",
  "license": "LGPL-2.1-or-later",
  "source": {
    "url": "https://ffmpeg.org/releases/ffmpeg-8.1.2.tar.xz",
    "sha256": "464beb5e7bf0c311e68b45ae2f04e9cc2af88851abb4082231742a74d97b524c"
  },
  "configure": [
    "--disable-everything",
    "--disable-autodetect",
    "--disable-doc",
    "--disable-debug",
    "--disable-iconv",
    "--enable-zlib",
    "--disable-bzlib",
    "--disable-lzma",
    "--disable-sdl2",
    "--disable-avdevice",
    "--disable-ffplay",
    "--disable-ffprobe",
    "--disable-audiotoolbox",
    "--enable-small",
    "--enable-static",
    "--disable-shared",
    "--enable-ffmpeg",
    "--enable-network",
    "--enable-securetransport",
    "--enable-videotoolbox",
    "--enable-avcodec",
    "--enable-avformat",
    "--enable-avfilter",
    "--enable-swscale",
    "--enable-swresample",
    "--enable-protocol=file",
    "--enable-protocol=pipe",
    "--enable-protocol=tcp",
    "--enable-protocol=tls",
    "--enable-protocol=http",
    "--enable-protocol=https",
    "--enable-demuxer=mov",
    "--enable-demuxer=gif",
    "--enable-demuxer=image2",
    "--enable-decoder=aac",
    "--enable-decoder=h264",
    "--enable-decoder=hevc",
    "--enable-decoder=gif",
    "--enable-decoder=png",
    "--enable-decoder=mjpeg",
    "--enable-parser=aac",
    "--enable-parser=h264",
    "--enable-parser=hevc",
    "--enable-hwaccel=h264_videotoolbox",
    "--enable-hwaccel=hevc_videotoolbox",
    "--enable-filter=aresample",
    "--enable-filter=scale",
    "--enable-filter=pad",
    "--enable-filter=format",
    "--enable-filter=setpts",
    "--enable-encoder=rawvideo",
    "--enable-encoder=flac",
    "--enable-muxer=rawvideo",
    "--enable-muxer=flac"
  ],
  "targets": {
    "aarch64-apple-darwin": {
      "executable": "ffmpeg-aarch64-apple-darwin",
      "strategy": "source-build"
    },
    "x86_64-apple-darwin": {
      "executable": "ffmpeg-x86_64-apple-darwin",
      "strategy": "source-build"
    }
  }
}
